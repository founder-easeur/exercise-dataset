# --- Backend (prefix EASEUR_) ---------------------------------------------
# PostgreSQL connection (docker compose provides this automatically)
EASEUR_DATABASE_URL=postgresql+psycopg2://easeur:easeur@127.0.0.1:5432/easeur

# Admin key for review actions / audit log / crawl triggers (X-API-Key header)
EASEUR_ADMIN_API_KEY=dev-admin-key

# Extraction quality gates
EASEUR_LOW_CONFIDENCE_THRESHOLD=0.55
EASEUR_DUPLICATE_AUTO_MERGE_THRESHOLD=0.99

# Optional: AI enrichment provider (OpenAI-compatible; off by default — AI is selective, never the default parser)
# EASEUR_AI_API_KEY=

# Crawler politeness (per-domain delay, page caps)
EASEUR_CRAWLER_MIN_DELAY_SECONDS=3.0
EASEUR_CRAWLER_MAX_PAGES_PER_JOB=60

# --- Frontend ---------------------------------------------------------------
# Backend URL as reachable from the Next.js server (in compose: http://api:8000)
BACKEND_URL=http://127.0.0.1:8000
